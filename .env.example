# Copy to .env and generate unique random secrets. Never commit .env.
POSTGRES_DB=rhythm
POSTGRES_USER=rhythm
POSTGRES_PASSWORD=
DATABASE_URL=postgres://rhythm:REPLACE_WITH_PASSWORD@127.0.0.1:5432/rhythm?sslmode=disable
SESSION_SECRET=
APP_HTTP_PORT=8081
PUBLIC_URL=http://localhost:8081
APP_ENV=development
APP_ADDR=127.0.0.1:8081
APP_TIMEZONE=Europe/Moscow
AUTH_RATE_LIMIT=20
# Generate once: go run ./cmd/web-push-keys. Preserve keys across deployments.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
# Only proxies that overwrite X-Real-IP with the actual client address.
TRUSTED_PROXY_CIDRS=

# Calendar connection also requires calendar:all in the Yandex OAuth app.
# The same client and callback are used for login and calendar consent.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=

NLP_PROVIDER=rules
# Key-free demo. Use scripts/service.py up --mode full for GigaChat.
GENA_NLU_MODE=semantic_plan_legacy

# Only for the explicit SQLite import command; remove after importing.
IMPORT_USER_EMAIL=dev@rhythm.local
IMPORT_USER_NAME=Разработчик
IMPORT_USER_PASSWORD=
GENA_SEMANTIC_PROVIDER=rules
GIGACHAT_AUTHORIZATION_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_BASE_URL=https://api.giga.chat
GIGACHAT_MODEL=GigaChat-3-Ultra
GIGACHAT_MAX_CONCURRENT=1
GIGACHAT_TIMEOUT=30s
# Cloud search uses the chat model. Hybrid optionally uses the embeddings API.
GENA_SEARCH_MODE=cloud
GENA_EMBEDDING_MODEL=Embeddings-2
GENA_SEARCH_BUDGET=8s
GENA_TURN_TIMEOUT=45s
GIGACHAT_CA_FILE=
# Optional absolute host path for a verified CA bundle mounted by the launcher.
GIGACHAT_CA_FILE_HOST=

# Optional server transcription. Audio stays in memory; never expose this key to web/.
GENA_STT_PROVIDER=
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
# Optional proxy used only by the Groq STT client. Keep credentials in secret env.
GROQ_PROXY_URL=

# Assistant reply playback only. Never expose this key through VITE_* variables.
GENA_TTS_PROVIDER=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_TTS_VOICE=ru-RU-DmitryNeural
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=
# Zoom Marketplace > Feature > Secret Token (separate from OAuth client secret).
ZOOM_WEBHOOK_SECRET_TOKEN=
