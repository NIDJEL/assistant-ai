# Copy to .env and generate unique random secrets. Never commit .env.
POSTGRES_DB=rhythm
POSTGRES_USER=rhythm
POSTGRES_PASSWORD=
DATABASE_URL=postgres://rhythm:REPLACE_WITH_PASSWORD@127.0.0.1:5432/rhythm?sslmode=disable
SESSION_SECRET=
PUBLIC_URL=http://localhost:8081
APP_ENV=development
APP_ADDR=127.0.0.1:8081
APP_TIMEZONE=Europe/Moscow
AUTH_RATE_LIMIT=20

YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:8081/api/auth/yandex/callback
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=http://localhost:8081/api/auth/vk/callback

NLP_PROVIDER=rules
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=20

# Only for the explicit SQLite import command; remove after importing.
IMPORT_USER_EMAIL=dev@rhythm.local
IMPORT_USER_NAME=Разработчик
IMPORT_USER_PASSWORD=
