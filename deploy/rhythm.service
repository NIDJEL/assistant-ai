[Unit]
Description=Rhythm production application
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/rhythm/current
ExecStart=/usr/bin/docker compose --env-file /etc/rhythm/production.env -f deploy/compose.production.yaml -f deploy/compose.gigachat.example.yaml up -d --wait --wait-timeout 120
ExecStop=/usr/bin/docker compose --env-file /etc/rhythm/production.env -f deploy/compose.production.yaml -f deploy/compose.gigachat.example.yaml stop
TimeoutStartSec=180
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
